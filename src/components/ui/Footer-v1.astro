---
const year = new Date().getFullYear();
---

<footer class="bg-[#021128] border-t border-white/10 text-white">

  <div class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-4 gap-10">

    <!-- Brand -->
    <div>

      <img
        src="/images/ad_restore_logo.jpg"
        alt="AdRestore"
        class="w-40 mb-4"
      />

      <p class="text-white/70 text-sm leading-relaxed">
        Ad Restore helps advertisers restore suspended Google Ads accounts
        through structured policy-aligned appeals and compliance reviews.
      </p>

    </div>

    <!-- Navigation -->
    <div>

      <h3 class="font-semibold mb-4 text-white/90">
        Navigation
      </h3>

      <ul class="space-y-3 text-white/70 text-sm">

        <li>
          <a href="#framework" class="hover:text-[#3BA6FF] transition-colors">
            How Recovery Works
          </a>
        </li>

        <li>
          <a href="#proof" class="hover:text-[#3BA6FF] transition-colors">
            Reinstatement Proof
          </a>
        </li>

        <li>
          <a href="#faq" class="hover:text-[#3BA6FF] transition-colors">
            FAQ
          </a>
        </li>

        <li>
          <a href="#consultation" class="hover:text-[#3BA6FF] transition-colors">
            Book Review
          </a>
        </li>

      </ul>

    </div>

    <!-- Legal -->
    <div>

      <h3 class="font-semibold mb-4 text-white/90">
        Legal
      </h3>

      <ul class="space-y-3 text-white/70 text-sm">

        <li>
          <a href="/privacy-policy" class="hover:text-[#3BA6FF] transition-colors">
            Privacy Policy
          </a>
        </li>

        <li>
          <a href="/terms" class="hover:text-[#3BA6FF] transition-colors">
            Terms & Conditions
          </a>
        </li>

        <li>
          <a href="/disclaimer" class="hover:text-[#3BA6FF] transition-colors">
            Disclaimer
          </a>
        </li>

      </ul>

    </div>

    <!-- Company Info -->
    <div>

      <h3 class="font-semibold mb-4 text-white/90">
        Company
      </h3>

      <div class="text-white/70 text-sm space-y-2">

        <p>
          <strong>Ad Restore Ltd</strong>
        </p>

        <p>
          Company No: SC825525
        </p>

        <p>
          18 Bellevue Street<br>
          Dumfries<br>
          United Kingdom<br>
          DG1 3EJ
        </p>

      </div>

    </div>

  </div>

  <!-- Bottom Bar -->

  <div class="border-t border-white/10">

    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col md:flex-row justify-between items-center text-sm text-white/60 gap-3">

      <p>
        © {year} Ad Restore Ltd. All rights reserved.
      </p>

      <p class="text-center md:text-right">
        Not affiliated with Google LLC or Google Ads.
      </p>

    </div>

  </div>

</footer>